# ========================================
# RAG 客服系統環境變數設定範例
# ========================================
# 複製此檔案為 .env 並填入實際值
# cp .env.example .env

# ========================================
# Gemini API 設定（主要 AI 服務）
# ========================================

# 【必要】Gemini API Key
# 前往 https://makersuite.google.com/app/apikey 取得
# 免費額度：每日 300 萬 tokens，60 RPM
GEMINI_API_KEY=AIzaSyBJ9tS7p6LJfbt46dENR73SymRWCj2MDoI

# 【選用】Gemini 模型設定
# 預設使用 gemini-2.0-flash-exp（最快最便宜）
# 其他選項：gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash-exp

# 【選用】Embedding 模型
# 用於 RAG 向量化
GEMINI_EMBEDDING_MODEL=text-embedding-004

# 【選用】API 超時時間（毫秒）
# GEMINI_TIMEOUT=9000

# ========================================
# RAG 知識庫設定
# ========================================

# 【必要】啟用 RAG 功能
# true: 啟用知識庫檢索
# false: 停用（只使用 AI 生成）
RAG_ENABLED=true

# 【選用】相似度門檻（0-1）
# 0.9: 嚴格（只回答非常相關的問題）
# 0.7: 推薦（平衡準確性和涵蓋率）
# 0.5: 寬鬆（可能回答不太相關的問題）
RAG_SIMILARITY_THRESHOLD=0.7

# 【選用】回傳結果數量
# 檢索時最多回傳幾個相關答案
RAG_TOP_K=3

# 【選用】知識庫文件路徑
# 放置 TXT/PDF/DOCX/XLSX 問答文件的資料夾
RAG_DOCUMENTS_PATH=./data/documents

# ========================================
# LINE Messaging API 設定
# ========================================

# 【必要】LINE Channel Access Token
# 前往 LINE Developers Console 取得
LINE_CHANNEL_ACCESS_TOKEN=DsX2Y2J6lhoNThLdJYl88r3DN/zbEK1zmd11THC+3UWCdALAEn1gsSLkp+VQWElvVw974T+XwF63lMNIvWienZO8McFKnoxhD+rm8rV9U+E7XGm3NaZk8BPFLKkuFzFCHB0FkbMksy5u/pH6br52ZAdB04t89/1O/w1cDnyilFU=

# 【必要】LINE Channel Secret
# 用於驗證 Webhook 請求
LINE_CHANNEL_SECRET=9fcfce808da5486824198cb96f2dbfcf

# 【選用】LINE API 超時時間（毫秒）
# LINE_TIMEOUT=9000

# ========================================
# OpenAI API 設定（選用）
# ========================================
# 保留用於 DALL-E 圖片生成和 Whisper 語音轉文字
# 如果不使用這些功能可以不設定

# OpenAI API Key
# OPENAI_API_KEY=

# OpenAI Base URL（如使用代理或自架服務）
# OPENAI_BASE_URL=https://api.openai.com

# 對話模型（當沒有 GEMINI_API_KEY 時使用）
# OPENAI_COMPLETION_MODEL=gpt-3.5-turbo

# 圖片生成模型
# OPENAI_IMAGE_GENERATION_MODEL=dall-e-2
# OPENAI_IMAGE_GENERATION_SIZE=256x256
# OPENAI_IMAGE_GENERATION_QUALITY=standard

# Vision 模型
# OPENAI_VISION_MODEL=gpt-4o

# ========================================
# 應用程式設定
# ========================================

# 執行環境
# production: 生產環境
# development: 開發環境
APP_ENV=production

# 除錯模式
# true: 顯示詳細日誌（包括 RAG 匹配資訊）
# false: 只顯示基本日誌
APP_DEBUG=false

# 應用程式語言
# zh_TW: 繁體中文
# en: English
# ja: 日本語
APP_LANG=zh_TW

# 服務埠號（本機開發用）
# 部署到 Vercel 時不需要設定
APP_PORT=3000

# Webhook 路徑
# LINE Webhook URL 的路徑部分
APP_WEBHOOK_PATH=https://tdance.fansee.studio/webhook

# API 超時時間（毫秒）
# 預設值，各服務可個別覆蓋
APP_API_TIMEOUT=9000

# ========================================
# 對話設定
# ========================================

# 最大群組數量
APP_MAX_GROUPS=1000

# 最大使用者數量
APP_MAX_USERS=1000

# 對話記憶訊息數量
# 保留最近幾則訊息作為上下文
APP_MAX_PROMPT_MESSAGES=4

# 對話記憶 Token 數量
# 限制上下文的 token 數
APP_MAX_PROMPT_TOKENS=256

# ========================================
# 機器人設定
# ========================================

# 機器人名稱
# 顯示在對話中的名稱
BOT_NAME=AI客服

# 機器人語氣
# 描述機器人的回應風格
BOT_TONE=友善專業

# 機器人初始提示詞
# 設定機器人的角色和行為
# BOT_INIT_PROMPT=你是一個專業的客服助理

# 預設停用機器人
# true: 需要手動啟用才會回應
# false: 自動回應
BOT_DEACTIVATED=false

# ========================================
# 進階設定（通常不需修改）
# ========================================

# 應用程式 URL（用於重導向）
# APP_URL=

# 系統初始提示詞
# APP_INIT_PROMPT=

# 人類使用者名稱
# HUMAN_NAME=

# 人類初始提示詞
# HUMAN_INIT_PROMPT=

# 停用錯誤訊息顯示
# ERROR_MESSAGE_DISABLED=false

# ========================================
# Vercel 部署設定（自動設定，不需手動填寫）
# ========================================

# VERCEL_ENV=
# VERCEL_PROJECT_NAME=
# VERCEL_TEAM_ID=
# VERCEL_ACCESS_TOKEN=
# VERCEL_DEPLOY_HOOK_URL=
# VERCEL_TIMEOUT=

# ========================================
# SerpAPI 搜尋設定（選用）
# ========================================
# 如果要使用網路搜尋功能

# SERPAPI_API_KEY=
# SERPAPI_LOCATION=tw
# SERPAPI_TIMEOUT=9000

# ========================================
# 完成！
# ========================================
# 必要設定：
# 1. GEMINI_API_KEY（Gemini AI）
# 2. LINE_CHANNEL_ACCESS_TOKEN（LINE）
# 3. LINE_CHANNEL_SECRET（LINE）
# 4. RAG_ENABLED=true（啟用知識庫）
#
# 選用設定：
# - APP_DEBUG=true（開發時建議開啟）
# - OPENAI_API_KEY（如需圖片生成/語音功能）
# - 其他進階設定根據需求調整
#
# 使用說明：
# https://github.com/memochou1993/gpt-ai-assistant
# ========================================
